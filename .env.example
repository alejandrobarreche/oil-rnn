# Copia este archivo como .env en cada ordenador y ajusta lo que cambie entre máquinas.
# .env no se sube a git. Sin .env, todo usa las carpetas del proyecto.

# Carpeta de datos alternativa (disco externo, ruta compartida…). Debe contener raw/, train/, val/, test/.
# DATA_DIR=/Volumes/datos/oil-rnn

# Nombre corto de este ordenador para los ids de los runs (por defecto, el hostname).
# MACHINE_NAME=mac

# Servidor de MLflow compartido. Tiene prioridad sobre configs/config.yaml.
# MLFLOW_TRACKING_URI=http://192.168.1.50:5000

# Claves de la API de datos (léelas en sources.py con os.getenv)
# MI_API_KEY=
